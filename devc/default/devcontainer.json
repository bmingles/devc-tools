{
  "name": "Default",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers-community/features/deno:1": {},
    "ghcr.io/devcontainers/features/git-lfs:1": {
      "autoPull": false
    },
    "ghcr.io/devcontainers/features/go:1": { "version": "latest" },
    "ghcr.io/devcontainers/features/node:1": {
      "nodeGypDependencies": true,
      "version": "latest",
      "pnpmVersion": "none",
      "nvmVersion": "latest"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "installTools": true,
      "version": "3.12"
    }
  },
  "remoteEnv": {
    "LANG": "en_US.utf8",
    "PROJECT_PATH": "${containerWorkspaceFolder}",
    "TZ": "America/Chicago",
    // Stop the Claude CLI from overwriting the terminal title with the current
    // task, so the project-name title set in bashrc-additions.sh persists.
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "initializeCommand": "bash \"${localWorkspaceFolder}/.devcontainer/initialize-command.sh\"",
  "postCreateCommand": "bash \"${containerWorkspaceFolder}/.devcontainer/post-create.sh\"",
  "mounts": [
    // ~/.claude folder
    "type=volume,source=claude-code-config-${localWorkspaceFolderBasename},target=/home/vscode/.claude",

    // ~/.claude.json (auth) persisted per-workspace via volume, mounted in devc's namespace
    // (alongside claude-seed, out of ~); agents-setup.sh symlinks ~/.claude.json to it
    "type=volume,source=claude-json-${localWorkspaceFolderBasename},target=/usr/local/share/devc/claude-json",

    // Host ~/.claude config seed: agents-setup.sh symlinks every top-level *file* from here
    // into ~/.claude. Directories are ignored — the devc:skills fence owns ~/.claude/skills/.
    "type=bind,source=${localEnv:HOME}/.config/devc/.claude,target=/usr/local/share/devc/claude-seed,consistency=cached,readonly",

    // Git identity extracted from the host by initialize-command.sh. Read-only, and
    // deliberately not the host's ~/.gitconfig — see that script for why.
    "type=bind,source=${localEnv:HOME}/.config/devc/gitconfig-identity,target=/usr/local/share/devc/gitconfig-identity,consistency=cached,readonly",

    // User-level shell customization: every *.sh in here is sourced by every interactive
    // container shell, before the project's own .devcontainer/shell/. See the devc:shell-dirs
    // block in scripts/bashrc-additions.sh. Read-only and live — host edits apply to the next
    // new shell. initialize-command.sh creates the source, since a bind mount will not.
    "type=bind,source=${localEnv:HOME}/.config/devc/shell,target=/usr/local/share/devc/shell,consistency=cached,readonly",

    // devc-bridge: token written by the host bridge. Read-only — the container only ever
    // reads the token, and a writable run/ lets a container feed `devc-bridge stop` an
    // arbitrary PID to SIGTERM on the host.
    "type=bind,source=${localEnv:HOME}/.config/devc-bridge/run,target=/run/devc-bridge,consistency=cached,readonly",

    // devc-bridge: host-built Linux client. A *directory* mount so a rebuilt client shows
    // through live (a file mount would pin the inode). scripts/bridge-client-link.sh puts it
    // on PATH. initialize-command.sh creates both sources, so these binds are inert rather
    // than fatal on a host that never installed the bridge.
    "type=bind,source=${localEnv:HOME}/.config/devc-bridge/client,target=/usr/local/share/devc/bridge-client,consistency=cached,readonly",

    "type=volume,source=go-cache-${localWorkspaceFolderBasename},target=/home/vscode/go/pkg",
    "type=volume,source=go-build-cache-${localWorkspaceFolderBasename},target=/root/.cache/go-build",
    "type=volume,source=node-modules-${localWorkspaceFolderBasename},target=${containerWorkspaceFolder}/node_modules"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "denoland.vscode-deno",
        "golang.go",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "claudeCode.allowDangerouslySkipPermissions": true,
        "claudeCode.initialPermissionMode": "bypassPermissions",
        "chat.agent.maxRequests": 50,
        "chat.tools.terminal.autoApprove": { "/.*/": true },
        "chat.tools.terminal.ignoreDefaultAutoApproveRules": true,
        "editor.formatOnSave": true,
        "terminal.integrated.defaultProfile.linux": "bash",
        "workbench.colorCustomizations": {
          "statusBar.background": "#7c3aed",
          "statusBar.foreground": "#ffffff",
          "titleBar.activeBackground": "#7c3aed",
          "titleBar.activeForeground": "#ffffff",
          "titleBar.inactiveBackground": "#5b21b6",
          "titleBar.inactiveForeground": "#ffffff",
          "chat.requestBorder": "#e21010",
          "statusBarItem.remoteBackground": "#e21010"
        }
      }
    }
  }
}
