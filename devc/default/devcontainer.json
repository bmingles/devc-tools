{
  "name": "Default",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "features": {
    "./features/devc": {},
    "ghcr.io/devcontainers-community/features/deno:1": {},
    "ghcr.io/devcontainers/features/go:1": { "version": "latest" },
    "ghcr.io/devcontainers/features/node:1": {
      "nodeGypDependencies": true,
      "version": "latest",
      "pnpmVersion": "none",
      "nvmVersion": "latest"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "installTools": true,
      "version": "3.12"
    }
  },
  "remoteEnv": {
    "LANG": "en_US.utf8",
    "PROJECT_PATH": "${containerWorkspaceFolder}",
    "TZ": "America/Chicago",
    // Stop the Claude CLI from overwriting the terminal title with the current
    // task, so the project-name title set in bashrc-additions.sh persists.
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  // Ensures the host-side ~/.claude seed directory exists before the mounts below are
  // established: `--mount type=bind` errors on a missing source, so without this a clone of
  // this config fails at create for anyone who has not run `devc`. Idempotent — this hook
  // also runs on subsequent starts. A Feature cannot carry it (the spec allows Features only
  // the five container-side hooks), so it has to live here, top-level. If a project overrides
  // it, either keep the mkdir or drop the claude-seed mount below alongside it.
  "initializeCommand": "mkdir -p \"$HOME/.config/devc-tui/.claude\"",
  "mounts": [
    // ~/.claude folder
    "type=volume,source=claude-code-config-${localWorkspaceFolderBasename},target=/home/vscode/.claude",

    // Host ~/.claude config seed: the devc Feature's postCreateCommand symlinks every
    // top-level *file* from here into ~/.claude. Directories are ignored — the devc:skills
    // fence owns ~/.claude/skills/.
    "type=bind,source=${localEnv:HOME}/.config/devc-tui/.claude,target=/usr/local/share/devc/claude-seed,consistency=cached,readonly",

    // ~/.claude.json (auth) persisted per-workspace via volume; the devc Feature's postCreateCommand sets up the symlink
    "type=volume,source=claude-json-${localWorkspaceFolderBasename},target=/home/vscode/.claude-json-vol",

    "type=volume,source=go-cache-${localWorkspaceFolderBasename},target=/home/vscode/go/pkg",
    "type=volume,source=go-build-cache-${localWorkspaceFolderBasename},target=/root/.cache/go-build",
    "type=volume,source=node-modules-${localWorkspaceFolderBasename},target=${containerWorkspaceFolder}/node_modules"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "denoland.vscode-deno",
        "golang.go",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "claudeCode.allowDangerouslySkipPermissions": true,
        "claudeCode.initialPermissionMode": "bypassPermissions",
        "chat.agent.maxRequests": 50,
        "chat.tools.terminal.autoApprove": { "/.*/": true },
        "chat.tools.terminal.ignoreDefaultAutoApproveRules": true,
        "editor.formatOnSave": true,
        "terminal.integrated.defaultProfile.linux": "bash",
        "workbench.colorCustomizations": {
          "statusBar.background": "#7c3aed",
          "statusBar.foreground": "#ffffff",
          "titleBar.activeBackground": "#7c3aed",
          "titleBar.activeForeground": "#ffffff",
          "titleBar.inactiveBackground": "#5b21b6",
          "titleBar.inactiveForeground": "#ffffff",
          "chat.requestBorder": "#e21010",
          "statusBarItem.remoteBackground": "#e21010"
        }
      }
    }
  }
}
