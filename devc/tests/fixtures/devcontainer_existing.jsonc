{
  // Hand-written by a human: devc must not touch anything outside its fences.
  "name": "demo",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "mounts": [
    // my ssh agent, nothing to do with devc
    "type=bind,source=/run/host-services/ssh-auth.sock,target=/ssh-agent"
    // >>> devc:projects (managed - do not edit)
    // <<< devc:projects
    // >>> devc:skills (managed - do not edit)
    // <<< devc:skills
  ],
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": ["ms-azuretools.vscode-docker"]
    }
  }
}
