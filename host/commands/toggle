#!/usr/bin/env bash
# Demo command that flips a state marker on/off. Used to exercise the server's
# state watcher (the tray's data source) without needing a GUI or macOS.
set -euo pipefail
STATE_DIR="${DEVC_HOST_STATE:-/tmp/devc-host/state}"
mkdir -p "$STATE_DIR"
MARKER="$STATE_DIR/toggle"
case "${1:-}" in
  on)  : > "$MARKER"; echo "on" ;;
  off) rm -f "$MARKER"; echo "off" ;;
  *)   echo "usage: toggle {on|off}" >&2; exit 2 ;;
esac
