# Client build artifact (compiled at devcontainer create time)
/client/devc-bridge

# Host tool build artifacts
#   host.app/     — `deno task dev` (deno desktop main.ts) bundle
#   DevcBridge.app — `deno task build` bundle
# (`devc-bridge start` builds into ~/.config/devc-bridge/, outside the repo)
/host/devc-bridge
/host/host.app/
/host/DevcBridge.app/
