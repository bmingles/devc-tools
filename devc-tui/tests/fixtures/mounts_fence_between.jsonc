{
  "mounts": [
    // keep my ssh agent socket
    "type=bind,source=/run/host-services/ssh-auth.sock,target=/ssh-agent",
    // >>> devc-tui:projects (managed - do not edit)
    "type=bind,source=/old/projecta,target=/workspaces/projecta"
    // <<< devc-tui:projects
    ,
    // and my dotfiles
    "type=bind,source=/home/me/.dotfiles,target=/home/vscode/.dotfiles"
  ]
}
